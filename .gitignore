# ============================================================================
# PARANOID .gitignore - BLOCKS ALL CREDENTIALS, SECRETS, KEYS, TOKENS
# ============================================================================

# --- ENVIRONMENT FILES (ALL OF THEM) ---
.env
.env.*
*.env
.env.local
.env.development
.env.production
.env.test
.env.staging
.envrc
.direnv

# --- API KEYS & TOKENS ---
*apikey*
*api-key*
*api_key*
*apitoken*
*api-token*
*api_token*
*accesskey*
*access-key*
*access_key*
*secretkey*
*secret-key*
*secret_key*
*authtoken*
*auth-token*
*auth_token*
*bearertoken*
*bearer-token*
*bearer_token*
*jwttoken*
*jwt-token*
*jwt_token*
*sessiontoken*
*session-token*
*session_token*
*refreshtoken*
*refresh-token*
*refresh_token*

# --- GITHUB TOKENS ---
*github*token*
*github_token*
*github-token*
*githubpat*
*github-pat*
*github_pat*
*ghp_*
*ghs_*
*gho_*
*ghu_*
*ghr_*

# --- PRIVATE KEYS (ALL FORMATS) ---
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
*.pub
!favicon.svg
!public/*.svg
known_hosts
authorized_keys
ssh_config
.ssh/

# --- CERTIFICATES ---
*.cert
*.ca-bundle
*.chain
*.fullchain

# --- CREDENTIAL FILES ---
*credential*
*credentials*
*password*
*passwd*
*.htpasswd
.netrc
.auth
.token
.tokens
secrets.json
secrets.yaml
secrets.yml
secrets.toml
secrets.ini
secrets.txt
config.json
config.yaml
config.yml
!package.json
!tsconfig*.json
!components.json

# --- DATABASE FILES ---
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.backup
*.bak

# --- LOG FILES ---
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- NODE MODULES & DEPENDENCIES ---
node_modules/
npm_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- BUILD OUTPUTS ---
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.vuepress/dist
.tsup/
storybook-static/
coverage/
.nyc_output/

# --- IDE & EDITOR FILES ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.iml
*.ipr
*.iws

# --- OS FILES ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db
desktop.ini

# --- TEMPORARY FILES ---
*.tmp
*.temp
*.cache
.cache/
*.pid
*.seed
*.pid.lock

# --- UPLOADED USER CONTENT ---
uploads/
upload/
attachments/
files/

# --- MISCELLANEOUS SENSITIVE ---
*.bak
*.orig
*.rej
*.patch
*.diff
.history/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache

# --- FIREBASE / GOOGLE CLOUD ---
.firebase/
.firebaserc
.google*
google-services.json
GoogleService-Info.plist

# --- AWS / CLOUD CREDENTIALS ---
.aws/
*.aws
credentials.csv

# --- VERCEL / NETLIFY ---
.vercel
.netlify

# --- DOCKER (if used) ---
*.env.docker
docker-compose.override.yml

# --- NEVER IGNORE THESE (keep them) ---
!README.md
!LICENSE
!public/
!src/
!index.html
!vite.config.ts
!tailwind.config.js
!postcss.config.js
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!eslint.config.js
!package.json
